# Copy this file to .env and fill it in. .env is never committed, so secrets stay on this computer.
# Never put a real password, key or token in any other file.

# Which backend the dev server passes /api requests to.
#   http://localhost:5001  your normal backend (Neon data)
#   http://localhost:5002  the throwaway test backend used by the browser tests
API_TARGET=http://localhost:5001

# --- Browser tests only (npm run test:e2e) ---
# Passwords for the throwaway accounts each run creates. Make up any two of at least 10 characters.
E2E_PASSWORD=
E2E_NEW_PASSWORD=
# Optional: where the frontend and Mailpit run, if not the usual addresses.
# E2E_BASE_URL=http://localhost:5173
# MAILPIT_URL=http://localhost:8025
